# ============================================================
# Plataforma Novera — variáveis de ambiente
# Copie para .env (local). Na Vercel, cadastre em Settings → Environment Variables.
# ============================================================

PORT=3000

# --- Banco de dados (Supabase → Connect → Transaction pooler, porta 6543) ---
# Sem DATABASE_URL, o projeto usa um Postgres local embutido (PGlite) em data/pglite.
DATABASE_URL=
# Opcional: certificado CA do Supabase (Settings → Database → SSL) para validar o TLS.
# DATABASE_CA_CERT=

# --- Armazenamento de arquivos (Supabase → Settings → API) ---
# Sem estas duas, os arquivos ficam em disco local (storage/uploads) — só para desenvolvimento.
SUPABASE_URL=
# Chave secreta (service_role). NUNCA exponha no navegador nem commite.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=materiais

# Limite por arquivo em MB (o plano gratuito do Supabase aceita até 50 MB)
MAX_UPLOAD_MB=50

# --- Administrador: usado SOMENTE pelo `npm run seed` (não precisa ir para a Vercel) ---
# O banco guarda apenas o hash bcrypt da senha.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
