# ============================================================
# Plataforma Novera — variáveis de ambiente
# Copie para .env (local). Na Vercel, cadastre em Settings → Environment Variables.
# ============================================================

PORT=3000

# --- Banco de dados (Supabase → Connect → Transaction pooler, porta 6543) ---
# Também aceito como POSTGRES_URL (nome criado pela integração Supabase ↔ Vercel).
# Sem esta variável, o projeto usa um Postgres local embutido (PGlite) em data/pglite.
DATABASE_URL=
# Opcional: certificado CA do Supabase (Settings → Database → SSL) para validar o TLS.
# DATABASE_CA_CERT=

# --- Supabase (Project Settings → API / API Keys) ---
# Endereço do projeto. Também aceito como NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable). Pode ir para o navegador; o servidor não depende dela.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (service_role "eyJ..." ou "sb_secret_..."). Também aceita como SUPABASE_SECRET_KEY.
# É ela que permite ao servidor usar o Storage privado. NUNCA exponha no navegador nem commite.
# Sem ela (e sem DATABASE_URL), arquivos ficam em disco local — só para desenvolvimento.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=materiais

# Limite por arquivo em MB (o plano gratuito do Supabase aceita até 50 MB)
MAX_UPLOAD_MB=50

# --- Administrador: usado SOMENTE pelo `npm run seed` (não precisa ir para a Vercel) ---
# O banco guarda apenas o hash bcrypt da senha.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
