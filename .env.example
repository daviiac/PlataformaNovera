PORT=3000
NODE_ENV=development

# Credenciais do administrador, lidas SOMENTE pelo script de seed (npm run seed).
# O banco guarda apenas o hash bcrypt da senha.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

MAX_UPLOAD_MB=200
# Em produção atrás de proxy reverso (HTTPS), defina NODE_ENV=production e TRUST_PROXY=1
