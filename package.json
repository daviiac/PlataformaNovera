{
  "name": "plataforma-novera",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Novera - estudo de inglês com nivelamento e trilhas A1, A2 e B2",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.js",
    "seed:reset-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.js --reset-admin",
    "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2"
  }
}
